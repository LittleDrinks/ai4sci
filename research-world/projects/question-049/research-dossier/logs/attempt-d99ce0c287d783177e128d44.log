s; results are restricted to finite-time empirical bounds and specific solver tolerances, lacking rigorous backward-error analysis validation.\"}, \"execution\": {\"id\": \"execution:6de8021338a90f7b57446c82\", \"project_id\": \"project:531933d02a4518d4440cbc36653e99c974c9b4a0b7dd3aaac83dfdd9d5ae5558\", \"attempt_id\": \"attempt:0c305bf6961d83af355d1222\", \"environment_id\": \"environment:10b3b3f5fd10b755d01cf28a496252245a7f8e3fb2b21a11db8f80af151387ef\", \"image_digest\": \"sha256:c12ffdf061d828759824b127bdd746a4ab0fbb71e9aa808b87cb7d73eebc396d\", \"command\": [\"python\", \"experiment.py\"], \"input_artifact_id\": \"artifact:9bd3fb1516b9eaacf3b89fd0f484f3908ba8943d52f495da323cc9f906c75101\", \"input_hash\": \"9bd3fb1516b9eaacf3b89fd0f484f3908ba8943d52f495da323cc9f906c75101\", \"seed\": 42, \"spec\": {\"image\": \"sha256:c12ffdf061d828759824b127bdd746a4ab0fbb71e9aa808b87cb7d73eebc396d\", \"command\": [\"python\", \"experiment.py\"], \"input_artifact_id\": \"artifact:9bd3fb1516b9eaacf3b89fd0f484f3908ba8943d52f495da323cc9f906c75101\", \"seed\": 42, \"files\": {\"experiment.py\": \"\"}, \"network\": \"none\", \"read_only\": true, \"limits\": {\"cpus\": 1, \"memory_mb\": 512, \"pids\": 128}}, \"exit_code\": 0, \"output_artifact_id\": \"artifact:75e31debbfd63b0afc7466baf8fc2a79761cb5d1fd2db8286dab623eecdba645\", \"output_hash\": \"75e31debbfd63b0afc7466baf8fc2a79761cb5d1fd2db8286dab623eecdba645\", \"usage\": {\"wall_ms\": 1391, \"replay_verified\": true, \"replay_output_hash\": \"75e31debbfd63b0afc7466baf8fc2a79761cb5d1fd2db8286dab623eecdba645\"}, \"created_at\": \"2026-08-13T19:20:29.450634+00:00\", \"stdout\": \"MAX_ENERGY_DEVIATION=1.40e-08\\n\"}}"}]}
